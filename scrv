#!/usr/bin/env bash
# scrv – toggle screensaver + screen lock
# X11:     Cinnamon, GNOME, MATE, KDE, XFCE
# Wayland: Hyprland (hypridle), Sway (swayidle), GNOME Wayland

PIDFILE="/tmp/scrv-inhibit.pid"
INTERVAL=20
VERSION="1.5.0"

case "${1:-}" in
    --version|-V) echo "scrv $VERSION"; exit 0 ;;
esac

# Simulace aktivity přes všechna dostupná rozhraní
poke() {
    # X11: resetuje idle timer na úrovni X serveru
    xset s reset 2>/dev/null

    # DBus: freedesktop standard (GNOME, KDE, XFCE, Cinnamon, ...)
    # + Cinnamon a GNOME vlastní rozhraní jako záloha
    for dest in org.freedesktop.ScreenSaver org.cinnamon.ScreenSaver org.gnome.ScreenSaver; do
        dbus-send --session --dest="$dest" --type=method_call \
            "/${dest//./\/}" "${dest}.SimulateUserActivity" 2>/dev/null
    done

    # Přímá deaktivace pokud spořič přesto naběhl
    cinnamon-screensaver-command --deactivate 2>/dev/null
    gnome-screensaver-command    --deactivate 2>/dev/null
}

# Pozn. ke kompatibilitě s Hyprland/Omarchy: hypridle na SIGUSR1/SIGUSR2 vůbec
# nereaguje – neošetřený signál proces rovnou zabije (výchozí akce jádra).
# Dřívější "pozastavení" přes `pkill -SIGUSR1 hypridle` proto hypridle zabíjelo
# a po opětovném zapnutí scrv se spořič už nikdy nereaktivoval, protože démon
# přestal běžet. Stejný problém má i swayidle (SIGUSR1 tam navíc znamená
# "vynuť timeout hned", ne pauzu; SIGUSR2 je zcela neošetřený signál, který by
# proces rovněž zabil). Signály se proto vůbec nepoužívají – idle inhibice na
# Waylandu jde čistě přes systemd-inhibit (logind), který hypridle i swayidle
# nativně respektují nezávisle na kompozitoru.
#
# Omarchy 4 (Quattro) ale hypridle úplně opustil - idle/screensaver/lock teď
# řeší vlastní IdleMonitor přímo v Omarchy shellu (Quickshell), a ten
# systemd-inhibit vůbec nesleduje (respectInhibitors se tam týká Waylandího
# idle-inhibit protokolu z aplikací jako mpv/prohlížeč, ne logind locků).
# Jediný podporovaný způsob je přepínač "Stay Awake" přes
# `omarchy toggle idle`, ktery jen vytvari/maze
# ~/.local/state/omarchy/indicators/stay-awake - viz omarchy_idle() nize.
omarchy_idle() {
    command -v omarchy >/dev/null 2>&1 && omarchy toggle idle "$1" >/dev/null 2>&1
}

# Nastavení gsettings pro všechna podporovaná DE
gs_set() {
    local val="$1"
    # Cinnamon
    gsettings set org.cinnamon.desktop.screensaver lock-enabled            "$val" 2>/dev/null
    gsettings set org.cinnamon.desktop.screensaver idle-activation-enabled "$val" 2>/dev/null
    # GNOME
    gsettings set org.gnome.desktop.screensaver    lock-enabled            "$val" 2>/dev/null
    # MATE
    gsettings set org.mate.screensaver             lock-enabled            "$val" 2>/dev/null
    gsettings set org.mate.screensaver             idle-activation-enabled "$val" 2>/dev/null
}

# ── toggle ──────────────────────────────────────────────────────────────────

if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE")
    kill -0 "$pid" 2>/dev/null && kill "$pid"
    rm -f "$PIDFILE"
    # Safety net: if the background subshell died without running its TERM
    # trap (e.g. the terminal it was started in got closed, sending SIGHUP,
    # which isn't trapped and kills the subshell before it can stop
    # systemd-inhibit), the "sleep infinity" it spawned is orphaned and goes
    # on blocking idle forever, even though the PID file is gone and this
    # script believes the screensaver is back on. Kill it by pattern too.
    pkill -f "systemd-inhibit --what=idle --who=scrv" 2>/dev/null
    gs_set true
    xset s on +dpms 2>/dev/null
    omarchy_idle allow-idle
    echo "🔒 Screensaver ZAPNUT"
    exit 0
fi

# --- VYPNOUT ---
gs_set false
xset s off -dpms 2>/dev/null  # X11: vypne X screensaver i DPMS
omarchy_idle stay-awake
poke                           # okamžitě resetovat idle timery

(
    # Ignore HUP: the subshell must survive the terminal it was started
    # in being closed, otherwise the systemd-inhibit child it holds is
    # orphaned instead of stopped (see the pkill safety net below the
    # PIDFILE branch above).
    trap '' HUP
    trap 'kill "$inhpid" 2>/dev/null; exit 0' TERM

    # systemd-inhibit: inhibit na úrovni logind – funguje nezávisle na DE,
    # respektují ho GNOME, KDE, XFCE i další; funguje i na Waylandu
    if command -v systemd-inhibit &>/dev/null; then
        systemd-inhibit --what=idle --who=scrv --why="Screensaver disabled" \
            sleep infinity &>/dev/null &
        inhpid=$!
    fi

    # Polling záloha pro DEs které ignorují logind inhibit nebo gsettings
    while true; do
        sleep "$INTERVAL"
        poke
    done
) &
pid=$!
echo "$pid" > "$PIDFILE"

echo "🔓 Screensaver VYPNUT (PID: $pid)"
exit 0
